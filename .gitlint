[general]
contrib=contrib-title-conventional-commits
ignore=title-min-length

[contrib-title-conventional-commits]
types=feat,fix,refactor,perf,test,docs,build,ci,chore

[title-max-length]
line-length=72

[title-match-regex]
regex=^[a-z]+(\([a-z]+(-[a-z]+)*\))?: (?!(?i:update|updates|cleanup|fixes|changes|improvements|stuff|misc|wip|tweaks|fix stuff|quick fix|minor fix|small fix|various fixes|minor changes)$)
